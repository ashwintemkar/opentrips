# AI backend mode (server-side only; never exposed to the client).
# true  = use local mock responses (src/lib/api/mock-risk.ts, mock-plan.ts)
# false = proxy /api/risk and /api/plan to AI_API_BASE_URL
USE_MOCK_AI=true

# Base URL of the FastAPI AI backend. Required when USE_MOCK_AI=false.
# Example: AI_API_BASE_URL=http://localhost:8000
AI_API_BASE_URL=

# Supabase login. Google and GitHub are turned on in the Supabase dashboard.
# Use the publishable key (sb_publishable_...). Never use the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production only (Render): public URL of this frontend, e.g.
# AUTH_URL=https://opentrips-web.onrender.com
AUTH_URL=

# Postgres for saved, shareable plans at /plans/[id].
#
# Local Docker (from repo root: docker compose up -d):
#   DATABASE_URL=postgresql://opentrips:opentrips@localhost:5432/opentrips
#
# Supabase (Render/production): Project Settings -> Database -> URI,
# use pooled Transaction mode (port 6543), then append:
#   ?pgbouncer=true&connection_limit=1
#
# If empty, save fails gracefully and the form falls back to /results
# (sessionStorage only). Nothing else blocks on it.
DATABASE_URL=
